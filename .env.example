# Informe o ID do fluxo da Web criado no Google Analytics 4.
# Na Netlify, cadastre a mesma variável em Project configuration > Environment variables.
# O script só é carregado depois que o visitante aceita métricas no banner de cookies.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Ambientes aceitos: local, preview, staging e production.
# Use "local" no computador do desenvolvedor. A Netlify define os demais contextos.
VITE_SITE_ENV=local
